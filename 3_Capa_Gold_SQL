DROP TABLE IF EXISTS MARKET.GOLD.FACT_VENTAS_AUX;

--1. CREATE TABLE MARKET.GOLD.FACT_VENTAS_AUX (
    ORDER_ID VARCHAR,
    PRODUCT_ID VARCHAR,
    ORDEN_INGRESO_CARRITO VARCHAR,
    ES_RECOMPRA VARCHAR,
    USER_ID VARCHAR,
    ORDEN_DIA_SEMANA VARCHAR,
    ORDEN_HORA_DEL_DIA VARCHAR,
    DIAS_DESDE_ULTIMA_COMPRA VARCHAR,
    NOMBRE_PRODUCTO VARCHAR,
    CATEGORIA VARCHAR,
    MARCA_LOCAL VARCHAR
);

COPY INTO MARKET.GOLD.FACT_VENTAS_AUX (
    ORDER_ID, 
    PRODUCT_ID, 
    ORDEN_INGRESO_CARRITO, 
    ES_RECOMPRA, 
    USER_ID, 
    ORDEN_DIA_SEMANA, 
    ORDEN_HORA_DEL_DIA, 
    DIAS_DESDE_ULTIMA_COMPRA, 
    NOMBRE_PRODUCTO, 
    CATEGORIA, 
    MARCA_LOCAL
)
FROM (
    SELECT 
        -- Las primeras 8 columnas se extraen de forma normal buscando sus posiciones de comas
        SPLIT_PART($1, ',', 1) AS ORDER_ID,
        SPLIT_PART($1, ',', 2) AS PRODUCT_ID,
        SPLIT_PART($1, ',', 3) AS ORDEN_INGRESO_CARRITO,
        SPLIT_PART($1, ',', 4) AS ES_RECOMPRA,
        SPLIT_PART($1, ',', 5) AS USER_ID,
        SPLIT_PART($1, ',', 6) AS ORDEN_DIA_SEMANA,
        SPLIT_PART($1, ',', 7) AS ORDEN_HORA_DEL_DIA,
        SPLIT_PART($1, ',', 8) AS DIAS_DESDE_ULTIMA_COMPRA,
        
        -- El producto es todo lo que esté en medio de las primeras 8 columnas y las últimas 2
        REGEXP_REPLACE($1, '^([^,]+,){8}(.*),[^,]+,[^,]+$', '\\2') AS NOMBRE_PRODUCTO,
        
        -- La categoría es el penúltimo valor (capturado justo antes del final)
        REGEXP_REPLACE($1, '.*,([^,]+),[^,]+$', '\\1') AS CATEGORIA,
        
        -- La marca es todo lo que esté después de la última coma
        REGEXP_SUBSTR($1, '[^,]+$') AS MARCA_LOCAL
    FROM @MARKET.GOLD.MIS_ARCHIVOS
)
FILE_FORMAT = (
    TYPE = 'CSV'
    FIELD_DELIMITER = 'NONE' -- Lee toda la línea junta para que no se rompa nada
    SKIP_HEADER = 1
)
FORCE = TRUE;

SELECT MARCA_LOCAL, COUNT(*) as cantidad_filas
FROM MARKET.GOLD.FACT_VENTAS_AUX
GROUP BY MARCA_LOCAL
ORDER BY MARCA_LOCAL ASC;

-- 4. Creamos la tabla definitiva limpia y con los nombres de Power BI
CREATE OR REPLACE TABLE MARKET.GOLD.FACT_VENTAS AS
SELECT 
    TRY_CAST(ORDER_ID AS NUMBER) AS ID_ORDEN, 
    TRY_CAST(PRODUCT_ID AS NUMBER) AS ID_PRODUCTO, 
    TRY_CAST(ORDEN_INGRESO_CARRITO AS NUMBER) AS ORDEN_INGRESO_CARRITO, 
    TRY_CAST(ES_RECOMPRA AS NUMBER) AS RECOMPRA, 
    TRY_CAST(USER_ID AS NUMBER) AS ID_USUARIO, 
    CASE 
        WHEN ORDEN_DIA_SEMANA LIKE 'S%' AND ORDEN_DIA_SEMANA LIKE '%bado%' THEN 'Sábado'
        WHEN ORDEN_DIA_SEMANA LIKE 'M%' AND ORDEN_DIA_SEMANA LIKE '%rcoles%' THEN 'Miércoles'
        ELSE ORDEN_DIA_SEMANA 
    END AS ORDEN_DIA_SEMANA, 
    TRY_CAST(ORDEN_HORA_DEL_DIA AS NUMBER) AS ORDEN_HORA_DEL_DIA, 
    TRY_CAST(DIAS_DESDE_ULTIMA_COMPRA AS NUMBER) AS DIAS_DESDE_ULTIMA_COMPRA, -- <-- CORREGIDO AQUÍ
    NOMBRE_PRODUCTO, 
    CASE 
        WHEN LOWER(CATEGORIA) = 'pantry' THEN 'Almacén'
        WHEN LOWER(CATEGORIA) = 'produce' OR CATEGORIA = 'Frutas y Verduras' THEN 'Frutas y Verduras'
        WHEN CATEGORIA LIKE '%L%cteos%' OR LOWER(CATEGORIA) = 'dairy eggs' THEN 'Lácteos y Huevos'
        WHEN LOWER(CATEGORIA) = 'snacks' OR CATEGORIA = 'Golosinas y Snacks' THEN 'Golosinas y Snacks'
        WHEN LOWER(CATEGORIA) = 'beverages' OR CATEGORIA = 'Bebidas' THEN 'Bebidas'
        WHEN LOWER(CATEGORIA) = 'frozen' OR CATEGORIA = 'Congelados' THEN 'Congelados'
        WHEN LOWER(CATEGORIA) = 'panaderÃa' OR LOWER(CATEGORIA) = 'bakery' OR CATEGORIA LIKE '%Panader%' THEN 'Panadería'
        WHEN LOWER(CATEGORIA) = 'canned goods' OR CATEGORIA = 'Enlatados y Conservas' THEN 'Conservas - Enlatados'
        WHEN LOWER(CATEGORIA) = 'deli' OR CATEGORIA = 'Fiambreia y Rotiseria' THEN 'Fiambrería y Rotisería'
        WHEN LOWER(CATEGORIA) = 'dry goods pasta' OR CATEGORIA = 'Pastas y Alimentos Secos' THEN 'Pastas Secas'
        WHEN LOWER(CATEGORIA) = 'household' OR CATEGORIA = 'Hogar' THEN 'Hogar'
        WHEN LOWER(CATEGORIA) = 'meat seafood' OR CATEGORIA = 'Carnes y Pescados' THEN 'Carnicería y Pescadería'
        WHEN LOWER(CATEGORIA) = 'breakfast' OR CATEGORIA = 'Desayuno y Merienda' THEN 'Desayuno'
        WHEN LOWER(CATEGORIA) = 'personal care' THEN 'Cuidado Personal'
        WHEN LOWER(CATEGORIA) = 'babies' OR CATEGORIA = 'Bebés' THEN 'Cuidado del Bebé'
        WHEN LOWER(CATEGORIA) = 'international' THEN 'Internacional'
        WHEN LOWER(CATEGORIA) = 'alcohol' THEN 'Bebidas con Alcohol'
        WHEN LOWER(CATEGORIA) = 'pets' THEN 'Mascotas'
        WHEN LOWER(CATEGORIA) = 'bulk' THEN 'A Granel'
        ELSE 'General'
    END AS CATEGORIA_PRODUCTO,
    
