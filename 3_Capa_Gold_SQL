-- 2. Cargamos uniendo las comas de productos rebeldes y asignando a las columnas correspondientes
COPY INTO MARKET.GOLD.FACT_VENTAS_AUX (
    ORDER_ID, 
    PRODUCT_ID, 
    ORDEN_INGRESO_CARRITO, 
    ES_RECOMPRA, 
    USER_ID, 
    ORDEN_DIA_SEMANA, 
    ORDEN_HORA_DEL_DIA, 
    DIAS_DESDE_ULTIMA_COMPRA, -- Corregido
    NOMBRE_PRODUCTO, 
    CATEGORIA, 
    MARCA_LOCAL
)
FROM (
    SELECT 
        $1, $2, $3, $4, $5, $6, $7, $8,
        -- Si Snowflake separó el producto por tener comas internas:
        CASE 
            WHEN $12 IS NOT NULL THEN CONCAT($9, ', ', $10, ', ', $11)
            WHEN $11 IS NOT NULL THEN CONCAT($9, ', ', $10)
            ELSE $9
        END,
        -- La categoría siempre es la penúltima con datos
        CASE 
            WHEN $12 IS NOT NULL THEN $12
            WHEN $11 IS NOT NULL THEN $11
            ELSE $10
        END,
        -- La marca siempre es la última con datos
        CASE 
            WHEN $12 IS NOT NULL THEN $13
            WHEN $11 IS NOT NULL THEN $12
            ELSE $11
        END
    FROM @MARKET.GOLD.MIS_ARCHIVOS
)
FILE_FORMAT = (
    TYPE = 'CSV'
    FIELD_DELIMITER = ','
    SKIP_HEADER = 1
    NULL_IF = ('', 'NULL', 'null', 'NaN')
    ERROR_ON_COLUMN_COUNT_MISMATCH = FALSE
)
FORCE = TRUE;

SELECT MARCA_LOCAL, COUNT(*) as cantidad_filas
FROM MARKET.GOLD.FACT_VENTAS_AUX
GROUP BY MARCA_LOCAL
ORDER BY MARCA_LOCAL ASC;
