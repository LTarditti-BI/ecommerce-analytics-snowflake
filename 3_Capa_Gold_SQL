-- 8. Creamos la tabla Calendario autogenerada
CREATE OR REPLACE TABLE MARKET.GOLD.Calendario AS
WITH GENERADOR_FECHAS AS (
    -- Generamos una fila por cada día para un rango amplio de años (de 2020 a 2026 inclusive)
    SELECT DATEADD(day, SEQ4(), '2020-01-01'::DATE) AS DATE_KEY
    FROM TABLE(GENERATOR(ROWCOUNT => 3000)) -- 3000 días son aprox 8 años
)
SELECT 
    DATE_KEY AS "Date",
    YEAR(DATE_KEY) AS "Año",
    MONTH(DATE_KEY) AS "Mes",
    DAY(DATE_KEY) AS "Dia_Numero",
    CASE DAYNAME(DATE_KEY)
        WHEN 'Mon' THEN 'Lunes'
        WHEN 'Tue' THEN 'Martes'
        WHEN 'Wed' THEN 'Miércoles'
        WHEN 'Thu' THEN 'Jueves'
        WHEN 'Fri' THEN 'Viernes'
        WHEN 'Sat' THEN 'Sábado'
        WHEN 'Sun' THEN 'Domingo'
    END AS "Dia_Semana"
FROM GENERADOR_FECHAS
WHERE DATE_KEY <= '2026-12-31'::DATE;

